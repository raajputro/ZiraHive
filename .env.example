# Copy this file to .env and fill it in.

# --- Required -------------------------------------------------------------
# Letters and numbers only (it goes into a URL). Generate one with:  python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=change-me
# Signs login tokens. Leave empty to auto-generate (stored in the data folder).
ZIRAHIVE_SECRET_KEY=

# --- Where things live on your PC (use forward slashes on Windows) ---------
# Your backups, thumbnails and app data. Put this on your biggest drive.
ZIRAHIVE_DATA_PATH=your_drive:/ZiraHiveData
# Your media folder. ZiraHive reads only this folder (never changes, moves or copies anything),
# and every folder inside it becomes a category by itself, named and typed from the folder name:
#   G:/Media/English Movies  -> "English Movies" (movies)
#   G:/Media/hindi_movies    -> "Hindi Movies"   (movies)
#   G:/Media/Web Series      -> "Web Series"     (series: seasons and episodes)
#   G:/Media/Animation       -> "Animation"      (movies and series together)
#   G:/Media/Music, Audiobooks, Ebooks, Comics
# setup.ps1 asks for it. New folders are added by themselves every night.
MEDIA_PATH=

# Optional, for media in more than one place: share a whole drive (read-only) and pick folders
# on it in Settings > Server > Categories > Choose folder. Off unless you add a line:
# DRIVE_E=E:/

# --- Network ---------------------------------------------------------------
ZIRAHIVE_HTTP_PORT=8080
# 0.0.0.0 = phones and TVs on your home Wi-Fi can connect. 127.0.0.1 = only this PC.
ZIRAHIVE_BIND=0.0.0.0
ZIRAHIVE_SITE_ADDRESS=:80

# --- Access from anywhere (docs/REMOTE_ACCESS.md) ------------------------------
# Auth key from https://login.tailscale.com/admin/settings/keys (needed once, at first start)
TS_AUTHKEY=
TS_HOSTNAME=zirahive
# serve.json = private app + public share links; serve-private-only.json = no public links
TS_SERVE_FILE=serve.json
# Your public share-link address, shown after setup, e.g. https://zirahive.tail1234.ts.net:8443
ZIRAHIVE_PUBLIC_URL=

# --- Home network ----------------------------------------------------------------
# This PC's address on your Wi-Fi, for Chromecasts and smart TVs, which fetch videos from
# ZiraHive by themselves. setup.ps1 fills it in. Give the PC a fixed address in your router
# (often "DHCP reservation") so it doesn't change.
ZIRAHIVE_LAN_URL=
# Read words in documents and photos so search finds them: documents, all or off
ZIRAHIVE_OCR=documents

# --- Video conversion ------------------------------------------------------------
# auto = use an NVIDIA GPU when docker-compose.yml gives one to ZiraHive, else the CPU
ZIRAHIVE_HW_ACCEL=auto
# How many videos may be converted at once (each uses a lot of CPU without a GPU)
ZIRAHIVE_MAX_TRANSCODES=3

# --- Optional ----------------------------------------------------------------
# Free key from https://www.themoviedb.org/settings/api for posters and plot summaries.
ZIRAHIVE_TMDB_API_KEY=

# --- Batch 7 -------------------------------------------------------------------------
# How linked ZiraHive servers see this one (Settings > Server > Linked ZiraHive servers)
ZIRAHIVE_SERVER_NAME=
# Voice chat in watch parties connects devices directly; at home and over Tailscale nothing else
# is needed. For people elsewhere, a STUN server helps, e.g. stun:stun.l.google.com:19302
ZIRAHIVE_ICE_SERVERS=

# --- Upgraded from GharBox (setup.ps1 fills these in when it finds an older install) --------
# DATABASE_VOLUME=gharbox_postgres-data
# POSTGRES_USER=gharbox
# POSTGRES_DB=gharbox
# TAILSCALE_VOLUME=gharbox_tailscale-state

# --- Local AI (docker compose --profile ai up -d; see docs/AI.md) -------------------------
# Answers questions; qwen2.5:1.5b for little memory, qwen2.5:7b with a GPU
ZIRAHIVE_LLM_MODEL=qwen2.5:3b
ZIRAHIVE_EMBED_MODEL=bge-m3
# Speech to subtitles: base (fast), small, medium (better Bangla, slow on a CPU)
ZIRAHIVE_WHISPER_MODEL=small
