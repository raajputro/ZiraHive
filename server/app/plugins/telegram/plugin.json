{
  "id": "telegram",
  "name": "Telegram messages",
  "description": "Sends a Telegram message when new movies arrive, a backup fails, or a watch party starts. Make a bot with @BotFather, send it a message, then fill in its token and your chat ID.",
  "version": "1.0",
  "author": "GharBox",
  "events": ["media.added", "backup.finished", "party.created", "user.created", "file.uploaded"],
  "settings": [
    {"key": "token", "label": "Bot token", "type": "secret", "help": "From @BotFather, like 123456:ABC-DEF..."},
    {"key": "chat_id", "label": "Chat ID", "type": "text", "help": "Your ID from @userinfobot, or a group's ID"},
    {"key": "new_media", "label": "New movies and episodes", "type": "bool", "default": true},
    {"key": "backups", "label": "Backup problems", "type": "bool", "default": true},
    {"key": "parties", "label": "Watch parties", "type": "bool", "default": true},
    {"key": "people", "label": "New people", "type": "bool", "default": false},
    {"key": "uploads", "label": "Every upload (busy!)", "type": "bool", "default": false}
  ]
}
