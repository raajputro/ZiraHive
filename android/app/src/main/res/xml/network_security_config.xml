<?xml version="1.0" encoding="utf-8"?>
<!-- At home ZiraHive is usually plain http on the local network (http://192.168.0.10:8080). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
